{
  "name": "pi-lingua",
  "version": "0.2.0",
  "description": "Pi extension: review the language you write to Pi while the agent does the real work, without ever blocking or rewriting the prompt.",
  "type": "module",
  "license": "MIT",
  "author": "eiei114",
  "keywords": [
    "pi-package",
    "pi",
    "language-learning",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eiei114/pi-lingua.git"
  },
  "bugs": {
    "url": "https://github.com/eiei114/pi-lingua/issues"
  },
  "homepage": "https://github.com/eiei114/pi-lingua#readme",
  "files": [
    "extensions/",
    "lib/",
    "docs/",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "ci": "npm run typecheck && npm test && npm run review:guardrails && npm run pack:check && npm run publish:guard",
    "pack:check": "npm pack --dry-run",
    "review:guardrails": "node scripts/check-review-guardrails.mjs",
    "publish:guard": "node scripts/check-no-npm-token.mjs"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.4",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@earendil-works/pi-tui": "^0.84.4",
    "@types/node": "^26.3.0",
    "typescript": "^7.0.2"
  }
}
